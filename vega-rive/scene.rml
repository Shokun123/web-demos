      <Fill><SolidColor colorValue="FF0F172A" /></Fill>
    </Shape>

    <!-- STATE MACHINE: 4 Core States (Idle, Listening, Speaking, Celebrating) -->
    <StateMachine id="0:7" name="VegaStateMachine">
      <StateMachineBool id="0:40" name="isListening" value="false" />
      <StateMachineBool id="0:41" name="isSpeaking" value="false" />
      <StateMachineTrigger id="0:42" name="celebrate" />

      <StateMachineLayer id="0:8" name="MainLayer">
        <AnyState id="0:50" x="0" y="-120">
          <StateTransition stateToId="0:55" duration="120">
            <TransitionTriggerCondition inputId="0:42" />
          </StateTransition>
        </AnyState>
        <ExitState id="0:51" x="600" y="-120" />
        <EntryState id="0:52" x="0" y="0">
          <StateTransition stateToId="0:53" duration="0" />
        </EntryState>

        <!-- State 1: Idle -->
        <AnimationState id="0:53" animationId="0:60" x="160" y="0">
          <StateTransition stateToId="0:54" duration="200">
            <TransitionBoolCondition inputId="0:40" opValue="equal" />
          </StateTransition>
          <StateTransition stateToId="0:56" duration="150">
            <TransitionBoolCondition inputId="0:41" opValue="equal" />
          </StateTransition>
        </AnimationState>

        <!-- State 2: Listening -->
        <AnimationState id="0:54" animationId="0:61" x="360" y="-80">
          <StateTransition stateToId="0:53" duration="200">
            <TransitionBoolCondition inputId="0:40" opValue="notEqual" />
          </StateTransition>
          <StateTransition stateToId="0:56" duration="150">
            <TransitionBoolCondition inputId="0:41" opValue="equal" />
          </StateTransition>
        </AnimationState>

        <!-- State 3: Speaking -->
        <AnimationState id="0:56" animationId="0:62" x="360" y="80">
          <StateTransition stateToId="0:53" duration="200">
            <TransitionBoolCondition inputId="0:41" opValue="notEqual" />
          </StateTransition>
        </AnimationState>

        <!-- State 4: Celebrating -->
        <AnimationState id="0:55" animationId="0:63" x="200" y="-120">
          <StateTransition stateToId="0:53" duration="250" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100" />
        </AnimationState>
      </StateMachineLayer>
    </StateMachine>

    <!-- ANIMATIONS -->
    <!-- 1. IDLE: Warm breathing, gentle head float, natural blink -->
    <LinearAnimation id="0:60" name="Idle" fps="60" duration="120" loopValue="1">
      <KeyedObject objectId="0:10">
