    <!-- BACKGROUND HALO & CANVAS (Last children draw at the very back) -->
    <Shape id="0:30" name="GlowHalo" x="300" y="300" opacity="0.22">
      <Ellipse width="390" height="390" />
      <Fill><SolidColor colorValue="FFF59E0B" /></Fill>
