            <Ellipse width="32" height="64" />
            <Fill><SolidColor colorValue="FFFDBA74" /></Fill>
          </Shape>
          <Shape name="EarRShape" x="0" y="-6">
            <Ellipse width="58" height="106" />
            <Fill><SolidColor colorValue="FFC2410C" /></Fill>
          </Shape>
        </Node>

      </Node>

      <!-- 2. ARMS (In front of torso, behind head) -->
      <Node id="0:25" name="ArmLeft" x="-92" y="68" rotation="0.32">
        <Shape name="ArmLShape" x="0" y="18">
          <Ellipse width="42" height="78" />
