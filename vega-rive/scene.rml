<Rive version="1" kind="fragment">
  <Artboard id="0:1" name="VegaCompanion" width="600" height="600" defaultStateMachineId="0:7">
    <!-- In RML, FIRST sibling draws on TOP, LAST sibling draws at the BACK! -->

    <!-- FOREGROUND SPARKLES (Draw on top of everything) -->
    <Shape id="0:101" name="StarL" x="115" y="155" opacity="0.9">
      <Star width="28" height="28" points="4" innerRadius="0.38" />
      <Fill><SolidColor colorValue="FFFDE047" /></Fill>
    </Shape>
    <Shape id="0:102" name="StarR" x="485" y="140" opacity="0.9">
      <Star width="32" height="32" points="4" innerRadius="0.38" />
      <Fill><SolidColor colorValue="FF38BDF8" /></Fill>
    </Shape>
    <Shape id="0:103" name="StarTop" x="300" y="68" opacity="0.75">
      <Star width="22" height="22" points="4" innerRadius="0.38" />
      <Fill><SolidColor colorValue="FFF472B6" /></Fill>
    </Shape>

    <!-- VEGA CHARACTER ROOT (First child inside VegaRoot draws on top) -->
    <Node id="0:10" name="VegaRoot" x="300" y="340">

      <!-- 1. HEAD GROUP (Draws in front of torso & arms) -->
      <Node id="0:11" name="HeadGroup" x="0" y="-42">

        <!-- Nose & Mouth (Topmost facial features) -->
        <Shape id="0:12" name="Nose" x="0" y="12">
          <Ellipse width="24" height="16" />
          <Fill><SolidColor colorValue="FF1E293B" /></Fill>
        </Shape>
        <Shape id="0:13" name="Mouth" x="0" y="36">
          <Ellipse width="34" height="18" />
          <Fill><SolidColor colorValue="FFBE123C" /></Fill>
        </Shape>

        <!-- Eyes with Specular Highlights (Highlight first so it draws on top of pupil!) -->
        <Node id="0:14" name="EyeLeft" x="-48" y="-8">
          <Shape name="EyeLHighlight" x="-6" y="-7">
            <Ellipse width="12" height="12" />
            <Fill><SolidColor colorValue="FFFFFFFF" /></Fill>
          </Shape>
          <Shape name="EyeLSparkle2" x="6" y="7">
            <Ellipse width="6" height="6" />
            <Fill><SolidColor colorValue="FF38BDF8" /></Fill>
          </Shape>
          <Shape name="EyeLPupil" x="0" y="0">
            <Ellipse width="32" height="36" />
            <Fill><SolidColor colorValue="FF0F172A" /></Fill>
          </Shape>
        </Node>

        <Node id="0:15" name="EyeRight" x="48" y="-8">
          <Shape name="EyeRHighlight" x="-6" y="-7">
            <Ellipse width="12" height="12" />
            <Fill><SolidColor colorValue="FFFFFFFF" /></Fill>
          </Shape>
          <Shape name="EyeRSparkle2" x="6" y="7">
            <Ellipse width="6" height="6" />
            <Fill><SolidColor colorValue="FF38BDF8" /></Fill>
          </Shape>
          <Shape name="EyeRPupil" x="0" y="0">
            <Ellipse width="32" height="36" />
            <Fill><SolidColor colorValue="FF0F172A" /></Fill>
          </Shape>
        </Node>

        <!-- Expressive Brows -->
        <Shape id="0:16" name="BrowL" x="-48" y="-36" rotation="-0.12">
          <Ellipse width="28" height="8" />
          <Fill><SolidColor colorValue="FF7C2D12" /></Fill>
        </Shape>
        <Shape id="0:17" name="BrowR" x="48" y="-36" rotation="0.12">
          <Ellipse width="28" height="8" />
          <Fill><SolidColor colorValue="FF7C2D12" /></Fill>
        </Shape>

        <!-- Rosy Cheeks -->
        <Shape id="0:18" name="CheekL" x="-70" y="20" opacity="0.65">
          <Ellipse width="32" height="18" />
          <Fill><SolidColor colorValue="FFFB7185" /></Fill>
        </Shape>
        <Shape id="0:19" name="CheekR" x="70" y="20" opacity="0.65">
          <Ellipse width="32" height="18" />
          <Fill><SolidColor colorValue="FFFB7185" /></Fill>
        </Shape>

        <!-- Cream Storybook Face Mask (Behind eyes/nose/mouth, in front of HeadBase) -->
        <Shape id="0:20" name="FaceMask" x="0" y="14">
          <Ellipse width="180" height="134" />
          <Fill><SolidColor colorValue="FFFFF7ED" /></Fill>
        </Shape>

